{
  "name": "lightdrawer-mcp",
  "version": "0.3.0",
  "description": "Local MCP server for LightDrawer: hash files or text on your machine, stamp or look up the fingerprint at lightdrawer.org, and verify receipts offline. Only the hash ever leaves your computer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lightdrawer-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "vendor",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/run.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desynced/lightdrawer-mcp.git"
  },
  "homepage": "https://github.com/desynced/lightdrawer-mcp",
  "bugs": {
    "url": "https://github.com/desynced/lightdrawer-mcp/issues"
  },
  "keywords": [
    "mcp",
    "lightdrawer",
    "opentimestamps",
    "timestamp",
    "receipt",
    "verify"
  ],
  "author": "Joe Ball",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
